# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY secrets (NOT prefixed NEXT_PUBLIC → never shipped to the browser).
# Used by the proxy route handlers in src/app/api/*.
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_API_URL=https://rookie-scorer-api.onrender.com
# The FastAPI X-API-Key. Stays server-side; the browser never sees it.
BACKEND_API_TOKEN=replace-with-your-backend-api-token

# Firebase Admin (server-side ID-token verification in the proxy). REQUIRED in
# production so only signed-in users can spend backend credits.
#
# EASIEST + most robust: paste the ENTIRE downloaded service-account JSON file
# contents into this ONE variable (raw JSON, or base64 of it). No newline mangling.
FIREBASE_SERVICE_ACCOUNT=
#
# ...OR provide the three fields individually (private key is newline-sensitive):
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC config (safe to expose; Firebase web config is public by design).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Budget + upload limits (configurable).
NEXT_PUBLIC_MONTHLY_QUOTA_USD=5
NEXT_PUBLIC_MAX_FILE_MB=20

# Leave empty to use Firebase auth. Set to "true" to run WITHOUT Firebase using a
# local mock login (handy for local dev / preview before Firebase is set up).
NEXT_PUBLIC_AUTH_DEV_MODE=true
